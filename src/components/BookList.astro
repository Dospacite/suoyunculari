---
import type { Book } from '@/lib/directus';
import { renderMarkdown } from '@/lib/markdown';

type Props = {
  books: Book[];
};

const { books } = Astro.props;

const categories = Array.from(
  new Set(books.map((book) => book.category).filter((item): item is string => Boolean(item))),
).sort((a, b) => a.localeCompare(b, 'tr'));

const languages = Array.from(
  new Set(books.map((book) => book.language).filter((item): item is string => Boolean(item))),
).sort((a, b) => a.localeCompare(b, 'tr'));

type BookMetaRow = {
  label: string;
  value: string;
};

function getBookMetaRows(book: Book): BookMetaRow[] {
  return [book.location ? { label: 'Konum', value: book.location } : undefined].filter(
    (row): row is BookMetaRow => Boolean(row),
  );
}

function getBookKicker(book: Book): string {
  return [book.category, book.author].filter(Boolean).join(' / ') || book.language || '';
}
---

<section class="play-browser" aria-label="Kütüphane arama">
  <div class="browser-tools">
    <label>
      <span>Arama</span>
      <input id="book-search" type="search" placeholder="Başlık, yazar, etiket" />
    </label>
    <label>
      <span>Kategori</span>
      <select id="book-category-filter">
        <option value="">Tümü</option>
        {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
      </select>
    </label>
    <label>
      <span>Dil</span>
      <select id="book-language-filter">
        <option value="">Tümü</option>
        {languages.map((language) => <option value={language.toLowerCase()}>{language}</option>)}
      </select>
    </label>
  </div>

  <div class="idea-list" id="book-list">
    {
      books.map((book) => {
        const tags = Array.isArray(book.tags) ? book.tags : [];
        const metaRows = getBookMetaRows(book);
        const notesHtml = renderMarkdown(book.notes);
        const kicker = getBookKicker(book);
        const searchable = [
          book.title,
          book.author,
          book.translator,
          book.category,
          book.language,
          book.location,
          book.notes,
          tags.join(' '),
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();

        return (
          <article
            class="idea-row"
            data-search={searchable}
            data-category={book.category?.toLowerCase() || ''}
            data-language={book.language?.toLowerCase() || ''}
          >
            <div>
              {kicker && <p class="kicker row-kicker">{kicker}</p>}
              <h2>{book.title}</h2>
              {book.translator && <p>{`Çev. ${book.translator}`}</p>}
              {notesHtml && (
                <div class="markdown-content" set:html={notesHtml} />
              )}
              <div class="taxonomy">
                {tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
            {metaRows.length > 0 && (
              <dl>
                {metaRows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        );
      })
    }
  </div>
  <p class="empty-state" id="book-empty" hidden>Eşleşen kitap bulunamadı.</p>
</section>

<script>
  const bookSearch = document.querySelector<HTMLInputElement>('#book-search');
  const bookCategory = document.querySelector<HTMLSelectElement>('#book-category-filter');
  const bookLanguage = document.querySelector<HTMLSelectElement>('#book-language-filter');
  const bookRows = Array.from(document.querySelectorAll<HTMLElement>('#book-list .idea-row'));
  const bookEmpty = document.querySelector<HTMLElement>('#book-empty');

  function updateBookRows() {
    const query = bookSearch?.value.trim().toLowerCase() || '';
    const selectedCategory = bookCategory?.value || '';
    const selectedLanguage = bookLanguage?.value || '';
    let visibleCount = 0;

    for (const row of bookRows) {
      const matchesSearch = row.dataset.search?.includes(query) ?? true;
      const matchesCategory = selectedCategory === '' || row.dataset.category === selectedCategory;
      const matchesLanguage = selectedLanguage === '' || row.dataset.language === selectedLanguage;
      const isVisible = matchesSearch && matchesCategory && matchesLanguage;
      row.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    }

    if (bookEmpty) bookEmpty.hidden = visibleCount > 0;
  }

  bookSearch?.addEventListener('input', updateBookRows);
  bookCategory?.addEventListener('change', updateBookRows);
  bookLanguage?.addEventListener('change', updateBookRows);
</script>
