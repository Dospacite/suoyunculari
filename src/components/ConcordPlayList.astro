<section class="play-browser" aria-label="Metin bankası tarayıcısı" data-concord-browser>
  <div class="browser-tools">
    <label>
      <span>Arama</span>
      <input id="concord-search" type="search" placeholder="Başlık, yazar, tür, tema" autocomplete="off" />
    </label>
    <label>
      <span>Kaynak</span>
      <select id="concord-source-filter">
        <option value="">Tümü</option>
      </select>
    </label>
    <label>
      <span>Tür</span>
      <select id="concord-genre-filter">
        <option value="">Tümü</option>
      </select>
    </label>
    <label>
      <span>Süre</span>
      <select id="concord-duration-filter">
        <option value="">Tümü</option>
        <option value="short">90 dk ve altı</option>
        <option value="medium">91-120 dk</option>
        <option value="long">120 dk üstü</option>
      </select>
    </label>
    <label>
      <span>Durum</span>
      <select id="concord-reference-filter">
        <option value="">Tümü</option>
        <option value="played">Oynandı</option>
        <option value="unplayed">Oynanmadı</option>
      </select>
    </label>
  </div>

  <details class="advanced-filters">
    <summary>Gelişmiş filtreler</summary>
    <div class="browser-tools advanced-grid">
      <label>
        <span>Oyun / Müzikal</span>
        <select id="concord-play-type-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <label>
        <span>Alt Tür</span>
        <select id="concord-subgenre-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <label>
        <span>Tema</span>
        <select id="concord-theme-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <label>
        <span>Hedef Kitle</span>
        <select id="concord-target-audience-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <label>
        <span>Performans Grubu</span>
        <select id="concord-performance-group-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <label>
        <span>Özellik</span>
        <select id="concord-feature-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <label>
        <span>Uyarı</span>
        <select id="concord-caution-filter">
          <option value="">Tümü</option>
        </select>
      </label>
      <div class="range-filter" data-range-filter data-min-param="minCast" data-max-param="maxCast" data-default-max="50">
        <span>Toplam Kadro</span>
        <output data-range-label>Tümü</output>
        <div class="dual-range">
          <input data-range-min type="range" min="0" max="50" value="0" aria-label="En az toplam kadro" />
          <input data-range-max type="range" min="0" max="50" value="50" aria-label="En çok toplam kadro" />
        </div>
      </div>
      <div class="range-filter" data-range-filter data-min-param="femaleRoles" data-max-param="femaleRolesMax" data-default-max="30">
        <span>Kadın Rolü</span>
        <output data-range-label>Tümü</output>
        <div class="dual-range">
          <input data-range-min type="range" min="0" max="30" value="0" aria-label="En az kadın rolü" />
          <input data-range-max type="range" min="0" max="30" value="30" aria-label="En çok kadın rolü" />
        </div>
      </div>
      <div class="range-filter" data-range-filter data-min-param="maleRoles" data-max-param="maleRolesMax" data-default-max="30">
        <span>Erkek Rolü</span>
        <output data-range-label>Tümü</output>
        <div class="dual-range">
          <input data-range-min type="range" min="0" max="30" value="0" aria-label="En az erkek rolü" />
          <input data-range-max type="range" min="0" max="30" value="30" aria-label="En çok erkek rolü" />
        </div>
      </div>
      <div class="range-filter" data-range-filter data-min-param="neutralRoles" data-max-param="neutralRolesMax" data-default-max="30">
        <span>Esnek Rol</span>
        <output data-range-label>Tümü</output>
        <div class="dual-range">
          <input data-range-min type="range" min="0" max="30" value="0" aria-label="En az esnek rol" />
          <input data-range-max type="range" min="0" max="30" value="30" aria-label="En çok esnek rol" />
        </div>
      </div>
    </div>
  </details>

  <p class="browser-status" id="concord-status">Kayıtlar yükleniyor...</p>

  <div class="play-list" id="concord-play-list"></div>
  <p class="empty-state" id="concord-empty" hidden>Eşleşen metin bulunamadı.</p>
  <p class="empty-state" id="concord-import-empty" hidden>Metin bankası kayıtları henüz yüklenemedi.</p>

  <div class="pager" id="concord-pager" hidden>
    <button type="button" id="concord-prev">Önceki</button>
    <span id="concord-page-label">1 / 1</span>
    <button type="button" id="concord-next">Sonraki</button>
  </div>
</section>

<script>
  type ConcordAuthor = {
    name: string;
  };

  type ConcordPlay = {
    source_url?: string;
    source?: string;
    source_id: string;
    title: string;
    summary_text?: string;
    authors?: ConcordAuthor[];
    play_type?: string;
    genres?: string[];
    duration_text?: string;
    duration_minutes?: number;
    casting_text?: string;
    played?: boolean;
    played_play_slug?: string;
    played_play_title?: string;
  };

  type ConcordSearchResponse = {
    items: ConcordPlay[];
    total: number;
    page: number;
    pageSize: number;
    totalPages: number;
    genres: string[];
    playTypes: string[];
    subgenres: string[];
    themes: string[];
    targetAudiences: string[];
    performanceGroups: string[];
    features: string[];
    cautions: string[];
    sources: string[];
    databaseReady: boolean;
  };

  const searchInput = document.querySelector<HTMLInputElement>('#concord-search');
  const sourceSelect = document.querySelector<HTMLSelectElement>('#concord-source-filter');
  const genreSelect = document.querySelector<HTMLSelectElement>('#concord-genre-filter');
  const playTypeSelect = document.querySelector<HTMLSelectElement>('#concord-play-type-filter');
  const subgenreSelect = document.querySelector<HTMLSelectElement>('#concord-subgenre-filter');
  const themeSelect = document.querySelector<HTMLSelectElement>('#concord-theme-filter');
  const targetAudienceSelect = document.querySelector<HTMLSelectElement>('#concord-target-audience-filter');
  const performanceGroupSelect = document.querySelector<HTMLSelectElement>('#concord-performance-group-filter');
  const featureSelect = document.querySelector<HTMLSelectElement>('#concord-feature-filter');
  const cautionSelect = document.querySelector<HTMLSelectElement>('#concord-caution-filter');
  const durationSelect = document.querySelector<HTMLSelectElement>('#concord-duration-filter');
  const referenceSelect = document.querySelector<HTMLSelectElement>('#concord-reference-filter');
  const list = document.querySelector<HTMLElement>('#concord-play-list');
  const empty = document.querySelector<HTMLElement>('#concord-empty');
  const importEmpty = document.querySelector<HTMLElement>('#concord-import-empty');
  const status = document.querySelector<HTMLElement>('#concord-status');
  const pager = document.querySelector<HTMLElement>('#concord-pager');
  const prevButton = document.querySelector<HTMLButtonElement>('#concord-prev');
  const nextButton = document.querySelector<HTMLButtonElement>('#concord-next');
  const pageLabel = document.querySelector<HTMLElement>('#concord-page-label');

  const pageSize = 25;
  let currentPage = 1;
  let totalPages = 1;
  let debounceTimer: number | undefined;
  const rangeFilters = Array.from(document.querySelectorAll<HTMLElement>('[data-range-filter]')).map((root) => ({
    root,
    minInput: root.querySelector<HTMLInputElement>('[data-range-min]'),
    maxInput: root.querySelector<HTMLInputElement>('[data-range-max]'),
    label: root.querySelector<HTMLOutputElement>('[data-range-label]'),
    minParam: root.dataset.minParam || '',
    maxParam: root.dataset.maxParam || '',
    defaultMax: Number(root.dataset.defaultMax || '0'),
  }));

  function debounceSearch() {
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(() => {
      currentPage = 1;
      void loadResults();
    }, 250);
  }

  async function loadResults() {
    if (!list || !empty || !importEmpty || !status || !pager) return;

    status.textContent = 'Kayıtlar yükleniyor...';
    status.hidden = false;

    const params = new URLSearchParams({
      q: searchInput?.value.trim() || '',
      source: sourceSelect?.value || '',
      playType: playTypeSelect?.value || '',
      genre: genreSelect?.value || '',
      subgenre: subgenreSelect?.value || '',
      theme: themeSelect?.value || '',
      targetAudience: targetAudienceSelect?.value || '',
      performanceGroup: performanceGroupSelect?.value || '',
      feature: featureSelect?.value || '',
      caution: cautionSelect?.value || '',
      duration: durationSelect?.value || '',
      reference: referenceSelect?.value || '',
      page: String(currentPage),
      pageSize: String(pageSize),
    });
    applyRangeParams(params);

    try {
      const response = await fetch(`/api/metin-bankasi/search.json?${params.toString()}`);
      const payload = (await response.json()) as ConcordSearchResponse;
      totalPages = payload.totalPages;
      currentPage = payload.page;

      updateGenres(payload.genres);
      updateSources(payload.sources);
      updateSelect(playTypeSelect, payload.playTypes);
      updateSelect(subgenreSelect, payload.subgenres);
      updateSelect(themeSelect, payload.themes);
      updateSelect(targetAudienceSelect, payload.targetAudiences);
      updateSelect(performanceGroupSelect, payload.performanceGroups);
      updateSelect(featureSelect, payload.features);
      updateSelect(cautionSelect, payload.cautions);
      renderResults(payload);
    } catch {
      list.innerHTML = '';
      empty.hidden = true;
      importEmpty.hidden = false;
      pager.hidden = true;
      status.textContent = 'Veritabanı bağlantısı kurulamadı.';
    }
  }

  function updateSources(sources: string[]) {
    if (!sourceSelect) return;
    const selected = sourceSelect.value;
    const options = ['<option value="">Tümü</option>'];

    for (const source of sources) {
      options.push(`<option value="${escapeAttribute(source)}">${escapeHtml(sourceLabel(source))}</option>`);
    }

    sourceSelect.innerHTML = options.join('');
    sourceSelect.value = sources.includes(selected) ? selected : '';
  }

  function updateGenres(genres: string[]) {
    updateSelect(genreSelect, genres);
  }

  function updateSelect(select: HTMLSelectElement | null, values: string[]) {
    if (!select) return;
    const selected = select.value;
    const options = ['<option value="">Tümü</option>'];

    for (const value of values) {
      options.push(`<option value="${escapeAttribute(value)}">${escapeHtml(value)}</option>`);
    }

    select.innerHTML = options.join('');
    select.value = values.includes(selected) ? selected : '';
  }

  function renderResults(payload: ConcordSearchResponse) {
    if (!list || !empty || !importEmpty || !status || !pager || !pageLabel || !prevButton || !nextButton) {
      return;
    }

    const hasActiveSearch =
      Boolean(searchInput?.value.trim()) ||
      Boolean(sourceSelect?.value) ||
      Boolean(playTypeSelect?.value) ||
      Boolean(genreSelect?.value) ||
      Boolean(subgenreSelect?.value) ||
      Boolean(themeSelect?.value) ||
      Boolean(targetAudienceSelect?.value) ||
      Boolean(performanceGroupSelect?.value) ||
      Boolean(featureSelect?.value) ||
      Boolean(cautionSelect?.value) ||
      Boolean(durationSelect?.value) ||
      rangeFilters.some(isRangeActive);
    const hasReferenceFilter = Boolean(referenceSelect?.value);
    const hasItems = payload.items.length > 0;

    list.innerHTML = hasItems ? payload.items.map(renderPlay).join('') : '';
    importEmpty.hidden = payload.databaseReady && (hasItems || hasActiveSearch || hasReferenceFilter || payload.total > 0);
    empty.hidden = hasItems || !payload.databaseReady || (!hasActiveSearch && !hasReferenceFilter && payload.total === 0);
    pager.hidden = !hasItems || payload.totalPages <= 1;
    pageLabel.textContent = `${payload.page} / ${payload.totalPages}`;
    prevButton.disabled = payload.page <= 1;
    nextButton.disabled = payload.page >= payload.totalPages;

    status.textContent = hasItems ? `${payload.total} kayıt bulundu.` : '';
    status.hidden = !hasItems;
  }

  function renderPlay(play: ConcordPlay) {
    const sourceText = sourceLabel(play.source || 'concord_theatricals');
    const authorText = play.authors?.map((author) => author.name).filter(Boolean).join(', ') || sourceText;
    const genreText = play.genres?.join(', ') || play.play_type || 'Play';
    const href = `/metin-bankasi/${encodeURIComponent(play.source || 'concord_theatricals')}/${encodeURIComponent(play.source_id)}`;
    const duration = play.duration_text || (play.duration_minutes ? `${play.duration_minutes} dk` : 'Belirsiz');
    const playedBadge = play.played
      ? `<span class="played-badge" title="${escapeAttribute(play.played_play_title || 'Oynandı')}">★ Oynandı</span>`
      : '';

    return `
      <article class="play-row">
        <a href="${escapeAttribute(href)}">
          <div>
            <p class="kicker row-kicker">${escapeHtml(genreText)}${playedBadge}</p>
            <h2>${escapeHtml(play.title)}</h2>
            <p>${escapeHtml(play.summary_text || 'Özet bilgisi bulunmuyor.')}</p>
          </div>
          <dl>
            <div>
              <dt>Yazar</dt>
              <dd>${escapeHtml(authorText)}</dd>
            </div>
            <div>
              <dt>Kaynak</dt>
              <dd>${escapeHtml(sourceText)}</dd>
            </div>
            <div>
              <dt>Kadro</dt>
              <dd>${escapeHtml(play.casting_text || 'Belirsiz')}</dd>
            </div>
            <div>
              <dt>Süre</dt>
              <dd>${escapeHtml(duration)}</dd>
            </div>
          </dl>
        </a>
      </article>
    `;
  }

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return entities[character];
    });
  }

  function sourceLabel(source: string) {
    const labels: Record<string, string> = {
      concord_theatricals: 'Concord',
      drama_online_library: 'Drama Online',
    };

    return labels[source] || source;
  }

  function escapeAttribute(value: string) {
    return escapeHtml(value);
  }

  searchInput?.addEventListener('input', debounceSearch);
  sourceSelect?.addEventListener('change', () => {
    currentPage = 1;
    void loadResults();
  });
  [
    genreSelect,
    playTypeSelect,
    subgenreSelect,
    themeSelect,
    targetAudienceSelect,
    performanceGroupSelect,
    featureSelect,
    cautionSelect,
    durationSelect,
  ].forEach((select) => {
    select?.addEventListener('change', () => {
      currentPage = 1;
      void loadResults();
    });
  });
  rangeFilters.forEach((filter) => {
    updateRangeLabel(filter);
    filter.minInput?.addEventListener('input', () => {
      updateRangeLabel(filter);
      debounceSearch();
    });
    filter.maxInput?.addEventListener('input', () => {
      updateRangeLabel(filter);
      debounceSearch();
    });
  });
  referenceSelect?.addEventListener('change', () => {
    currentPage = 1;
    void loadResults();
  });
  prevButton?.addEventListener('click', () => {
    currentPage = Math.max(1, currentPage - 1);
    void loadResults();
  });
  nextButton?.addEventListener('click', () => {
    currentPage = Math.min(totalPages, currentPage + 1);
    void loadResults();
  });

  void loadResults();

  function applyRangeParams(params: URLSearchParams) {
    for (const filter of rangeFilters) {
      const range = normalizedRange(filter);
      if (!range) continue;

      if (range.min > 0) params.set(filter.minParam, String(range.min));
      if (range.max < filter.defaultMax) params.set(filter.maxParam, String(range.max));
    }
  }

  function isRangeActive(filter: (typeof rangeFilters)[number]) {
    const range = normalizedRange(filter);
    return Boolean(range && (range.min > 0 || range.max < filter.defaultMax));
  }

  function updateRangeLabel(filter: (typeof rangeFilters)[number]) {
    const range = normalizedRange(filter);
    if (!filter.label || !range) return;
    filter.label.textContent = isRangeActive(filter) ? `${range.min}-${range.max}` : 'Tümü';
  }

  function normalizedRange(filter: (typeof rangeFilters)[number]) {
    if (!filter.minInput || !filter.maxInput || !filter.minParam || !filter.maxParam || !filter.defaultMax) {
      return null;
    }

    let min = Number(filter.minInput.value);
    let max = Number(filter.maxInput.value);

    if (!Number.isFinite(min)) min = 0;
    if (!Number.isFinite(max)) max = filter.defaultMax;
    min = Math.max(0, Math.min(filter.defaultMax, Math.trunc(min)));
    max = Math.max(0, Math.min(filter.defaultMax, Math.trunc(max)));

    if (min > max) {
      if (document.activeElement === filter.minInput) {
        max = min;
        filter.maxInput.value = String(max);
      } else {
        min = max;
        filter.minInput.value = String(min);
      }
    }

    return { min, max };
  }
</script>
