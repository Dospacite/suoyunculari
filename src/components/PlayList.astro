---
import { assetUrl, type Play } from '@/lib/directus';
import { markdownToPlainText } from '@/lib/markdown';

type Props = {
  plays: Play[];
};

const { plays } = Astro.props;

const genres = Array.from(
  new Set(plays.flatMap((play) => play.genres?.map((genre) => genre.name).filter(Boolean) ?? [])),
).sort((a, b) => a.localeCompare(b, 'tr'));

function formatPlayYear(value?: string): string | undefined {
  if (!value) return undefined;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : String(date.getFullYear());
}

function formatArchiveLabel(play: Play): string | undefined {
  const year = formatPlayYear(play.event_date);
  if (!year) return play.is_newcomer_play ? 'Yeniler' : undefined;
  return play.is_newcomer_play ? `${year} - Yeniler` : year;
}
---

<section class="play-browser" aria-label="Play browser">
  <div class="browser-tools">
    <label>
      <span>Arama</span>
      <input id="play-search" type="search" placeholder="Başlık, orijinal ad, yazar, tür" />
    </label>
    <label>
      <span>Tür</span>
      <select id="genre-filter">
        <option value="">Tümü</option>
        {genres.map((genre) => <option value={genre.toLowerCase()}>{genre}</option>)}
      </select>
    </label>
  </div>

  <div class="play-list play-thumbnail-grid" id="play-list">
    {
      plays.map((play) => {
        const yearLabel = formatArchiveLabel(play);
        const authorName = play.author?.name;
        const thumbnail = assetUrl(play.home_card_image || play.cover_image);
        const description = markdownToPlainText(play.short_description || play.summary);
        const genreSearch = play.genres?.map((genre) => genre.name.toLowerCase()).join(' ') ?? '';
        const searchable = [
          play.title,
          play.original_title,
          play.author?.name,
          play.short_description,
          play.cast,
          genres,
          play.tags?.map((tag) => tag.name).join(' '),
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();

        return (
          <article
            class="play-row"
            data-search={searchable}
            data-genre={genreSearch}
          >
            <a href={`/plays/${play.slug}`}>
              {yearLabel && <div class="play-card-year">{yearLabel}</div>}
              {
                thumbnail ? (
                  <img src={thumbnail} alt="" loading="lazy" />
                ) : (
                  <div class="play-card-fallback" aria-hidden="true"></div>
                )
              }
              <div class="play-card-copy">
                <h2>{play.title}</h2>
                {authorName && <p class="play-card-author">{authorName}</p>}
                {description && <p class="play-card-description">{description}</p>}
              </div>
            </a>
          </article>
        );
      })
    }
  </div>
  <p class="empty-state" id="play-empty" hidden>Eşleşen metin bulunamadı.</p>
</section>

<script>
  const search = document.querySelector<HTMLInputElement>('#play-search');
  const genre = document.querySelector<HTMLSelectElement>('#genre-filter');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.play-row'));
  const list = document.querySelector<HTMLElement>('#play-list');
  const empty = document.querySelector<HTMLElement>('#play-empty');

  function updateRows() {
    const query = search?.value.trim().toLowerCase() || '';
    const selectedGenre = genre?.value || '';
    let visibleCount = 0;

    for (const row of rows) {
      const matchesSearch = row.dataset.search?.includes(query) ?? true;
      const matchesGenre = selectedGenre === '' || row.dataset.genre?.includes(selectedGenre);
      const isVisible = matchesSearch && matchesGenre;
      row.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    }

    if (empty) empty.hidden = visibleCount > 0;
    if (list) list.dataset.visibleCount = String(visibleCount);
  }

  search?.addEventListener('input', updateRows);
  genre?.addEventListener('change', updateRows);
  updateRows();
</script>
