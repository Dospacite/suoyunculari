---
import type { Play } from '@/lib/directus';

type Props = {
  plays: Play[];
};

const { plays } = Astro.props;

const genres = Array.from(
  new Set(plays.flatMap((play) => play.genres?.map((genre) => genre.name).filter(Boolean) ?? [])),
).sort((a, b) => a.localeCompare(b, 'tr'));

const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

function formatPlayDate(value?: string): string {
  if (!value) return 'Yakında';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 'Yakında' : dateFormatter.format(date);
}
---

<section class="play-browser" aria-label="Play browser">
  <div class="browser-tools">
    <label>
      <span>Arama</span>
      <input id="play-search" type="search" placeholder="Başlık, orijinal ad, yazar, tür" />
    </label>
    <label>
      <span>Tür</span>
      <select id="genre-filter">
        <option value="">Tümü</option>
        {genres.map((genre) => <option value={genre.toLowerCase()}>{genre}</option>)}
      </select>
    </label>
  </div>

  <div class="play-list" id="play-list">
    {
      plays.map((play) => {
        const originalTitle = play.original_title || play.title;
        const authorName = play.author?.name || 'Yazar belirsiz';
        const genreSearch = play.genres?.map((genre) => genre.name.toLowerCase()).join(' ') ?? '';
        const searchable = [
          play.title,
          play.original_title,
          play.author?.name,
          play.director,
          play.cast,
          genres,
          play.tags?.map((tag) => tag.name).join(' '),
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();

        return (
          <article
            class="play-row"
            data-search={searchable}
            data-genre={genreSearch}
          >
            <a href={`/plays/${play.slug}`}>
              <div>
                <p class="kicker row-kicker">
                  {originalTitle} · {authorName}
                </p>
                <h2>{play.title}</h2>
                <p>{play.summary}</p>
              </div>
              <dl>
                <div>
                  <dt>Kadro</dt>
                  <dd>
                    {play.min_cast_size && play.max_cast_size
                      ? `${play.min_cast_size}-${play.max_cast_size}`
                      : 'Esnek'}
                  </dd>
                </div>
                <div>
                  <dt>Süre</dt>
                  <dd>{play.duration_minutes ? `${play.duration_minutes} dk` : 'Belirsiz'}</dd>
                </div>
                <div>
                  <dt>Tarih / Saat</dt>
                  <dd>{formatPlayDate(play.event_date)}</dd>
                </div>
              </dl>
            </a>
          </article>
        );
      })
    }
  </div>
  <p class="empty-state" id="play-empty" hidden>Eşleşen metin bulunamadı.</p>
</section>

<script>
  const search = document.querySelector<HTMLInputElement>('#play-search');
  const genre = document.querySelector<HTMLSelectElement>('#genre-filter');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.play-row'));
  const empty = document.querySelector<HTMLElement>('#play-empty');

  function updateRows() {
    const query = search?.value.trim().toLowerCase() || '';
    const selectedGenre = genre?.value || '';
    let visibleCount = 0;

    for (const row of rows) {
      const matchesSearch = row.dataset.search?.includes(query) ?? true;
      const matchesGenre = selectedGenre === '' || row.dataset.genre?.includes(selectedGenre);
      const isVisible = matchesSearch && matchesGenre;
      row.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    }

    if (empty) empty.hidden = visibleCount > 0;
  }

  search?.addEventListener('input', updateRows);
  genre?.addEventListener('change', updateRows);
</script>
