<div class="text-bank-assistant" data-text-bank-assistant>
  <button class="assistant-toggle" type="button" aria-expanded="false" aria-controls="text-bank-assistant-panel" aria-label="Pingo asistanını aç">
    <img src="/pingo.svg" alt="" aria-hidden="true" />
    <span>Pingo</span>
  </button>

  <section class="assistant-panel" id="text-bank-assistant-panel" aria-label="Pingo Metin Bankası asistanı" hidden>
    <div class="assistant-header">
      <div class="assistant-identity">
        <img src="/pingo.svg" alt="" aria-hidden="true" />
        <div>
          <h2>Pingo</h2>
          <span>Metin Bankası asistanı</span>
        </div>
      </div>
      <div class="assistant-actions">
        <button type="button" class="ghost-button assistant-clear">Temizle</button>
        <button type="button" class="ghost-button assistant-close" aria-label="Pingo'yu kapat">Kapat</button>
      </div>
    </div>

    <div class="assistant-tabs" role="tablist" aria-label="Asistan bölümleri">
      <button type="button" role="tab" data-assistant-tab="chat" aria-selected="true" aria-controls="assistant-tab-chat">
        Sohbet
      </button>
      <button type="button" role="tab" data-assistant-tab="results" aria-selected="false" aria-controls="assistant-tab-results">
        Sonuçlar <span data-result-count>0</span>
      </button>
      <button type="button" role="tab" data-assistant-tab="examples" aria-selected="false" aria-controls="assistant-tab-examples">
        Örnekler
      </button>
    </div>

    <div class="assistant-tab-panels">
      <div class="assistant-tab-panel" id="assistant-tab-chat" role="tabpanel" data-assistant-panel="chat">
        <div class="assistant-log" role="log" aria-live="polite"></div>
      </div>

      <div class="assistant-tab-panel" id="assistant-tab-results" role="tabpanel" data-assistant-panel="results" hidden>
        <div class="assistant-results-panel" data-results-panel></div>
      </div>

      <div class="assistant-tab-panel" id="assistant-tab-examples" role="tabpanel" data-assistant-panel="examples" hidden>
        <div class="assistant-examples">
          <p>Aramayı hızlandırmak için bir örnek seç.</p>
          <button type="button" data-example-prompt="5-7 kişilik kısa komedi arıyorum">5-7 kişilik kısa komedi</button>
          <button type="button" data-example-prompt="Lise öğrencileri için kalabalık kadrolu müzikal öner">Lise için kalabalık müzikal</button>
          <button type="button" data-example-prompt="Az dekor isteyen iki kişilik dramalar neler?">Az dekorlu iki kişilik drama</button>
          <button type="button" data-example-prompt="Türkçeye çevirmeye uygun çağdaş komedi ara">Çağdaş komedi ara</button>
        </div>
      </div>
    </div>

    <form class="assistant-form">
      <label class="sr-only" for="text-bank-assistant-input">Nasıl bir oyun arıyorsun?</label>
      <textarea
        id="text-bank-assistant-input"
        name="message"
        rows="2"
        maxlength="1000"
        placeholder="Nasıl bir oyun arıyorsun?"
      ></textarea>
      <button type="submit" class="primary-button">Gönder</button>
    </form>
    <p class="assistant-hint">Enter ile gönder, yeni satır için Shift+Enter.</p>
    <p class="assistant-error" aria-live="polite"></p>
  </section>
</div>

<script>
  type ChatMessage = {
    role: 'user' | 'assistant';
    text: string;
    results?: Array<{
      title: string;
      href: string;
      meta: string;
    }>;
  };

  type ChatResponse = {
    reply: string;
    results: Array<{
      title: string;
      href: string;
      meta: string;
      summary?: string;
    }>;
  };

  const STORAGE_KEY = 'suo_text_bank_chat_v1';
  const INITIAL_MESSAGE =
    "Merhaba, ben Pingo. Metin Bankası'nda oyun bulmana yardımcı olabilirim. Tür, kadro, süre, tema ya da hedef kitle söyleyebilirsin.";
  const MAX_MESSAGES = 12;
  const MAX_SEND_HISTORY = 8;
  const MAX_INPUT_LENGTH = 1000;
  const REQUEST_TIMEOUT_MS = 20000;

  const root = document.querySelector<HTMLElement>('[data-text-bank-assistant]');
  const toggle = root?.querySelector<HTMLButtonElement>('.assistant-toggle');
  const panel = root?.querySelector<HTMLElement>('.assistant-panel');
  const closeButton = root?.querySelector<HTMLButtonElement>('.assistant-close');
  const log = root?.querySelector<HTMLElement>('.assistant-log');
  const tabButtons = Array.from(root?.querySelectorAll<HTMLButtonElement>('[data-assistant-tab]') ?? []);
  const tabPanels = Array.from(root?.querySelectorAll<HTMLElement>('[data-assistant-panel]') ?? []);
  const resultsPanel = root?.querySelector<HTMLElement>('[data-results-panel]');
  const resultCount = root?.querySelector<HTMLElement>('[data-result-count]');
  const exampleButtons = Array.from(root?.querySelectorAll<HTMLButtonElement>('[data-example-prompt]') ?? []);
  const form = root?.querySelector<HTMLFormElement>('.assistant-form');
  const input = root?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  const clearButton = root?.querySelector<HTMLButtonElement>('.assistant-clear');
  const error = root?.querySelector<HTMLElement>('.assistant-error');

  let messages: ChatMessage[] = loadMessages();
  let isSending = false;
  let activeTab: 'chat' | 'results' | 'examples' = 'chat';

  if (root && toggle && panel && log && form && input && clearButton && closeButton && error && resultsPanel) {
    render();

    toggle.addEventListener('click', () => {
      const willOpen = panel.hidden;
      panel.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
      if (willOpen) input.focus();
    });

    closeButton.addEventListener('click', () => {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    });

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tab = button.dataset.assistantTab;
        if (tab === 'chat' || tab === 'results' || tab === 'examples') {
          setActiveTab(tab);
        }
      });
    });

    exampleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const prompt = button.dataset.examplePrompt?.trim();
        if (!prompt) return;
        input.value = prompt;
        setActiveTab('chat');
        input.focus();
      });
    });

    clearButton.addEventListener('click', () => {
      messages = initialMessages();
      persistMessages();
      render();
      setError('');
      setActiveTab('chat');
      input.focus();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey) return;
      event.preventDefault();
      form.requestSubmit();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isSending) return;

      const text = input.value.trim();
      if (!text) return;

      if (text.length > MAX_INPUT_LENGTH) {
        setError('Mesaj 1000 karakterden uzun olamaz.');
        return;
      }

      setError('');
      input.value = '';
      messages = trimMessages([...messages, { role: 'user', text }]);
      persistMessages();
      setActiveTab('chat');

      isSending = true;
      form.querySelector<HTMLButtonElement>('button[type="submit"]')?.setAttribute('disabled', 'true');
      input.setAttribute('disabled', 'true');
      render();

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

      try {
        const response = await fetch('/api/metin-bankasi/chat.json', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          signal: controller.signal,
          body: JSON.stringify({
            messages: messages.slice(-MAX_SEND_HISTORY).map((message) => ({
              role: message.role,
              text: message.text,
            })),
          }),
        });

        if (response.status === 503) {
          appendAssistantMessage('Pingo şu anda yapılandırılmamış. Lütfen daha sonra tekrar dene.', []);
          return;
        }

        const payload = (await response.json().catch(() => null)) as ChatResponse | null;

        if (response.status === 429 && isChatResponse(payload)) {
          appendAssistantMessage(payload.reply, []);
          return;
        }

        if (!response.ok) {
          appendAssistantMessage(
            isChatResponse(payload) ? payload.reply : 'Pingo şu anda yanıt veremiyor. Lütfen biraz sonra tekrar dene.',
            [],
          );
          return;
        }

        if (!isChatResponse(payload)) {
          appendAssistantMessage('Pingo beklenmeyen bir yanıt aldı. Lütfen biraz sonra tekrar dene.', []);
          return;
        }

        appendAssistantMessage(payload.reply, payload.results);
      } catch (caughtError) {
        const message =
          caughtError instanceof DOMException && caughtError.name === 'AbortError'
            ? 'Pingo yanıtı zamanında alamadı. Lütfen tekrar dene.'
            : 'Bağlantı kurulamadı. Lütfen tekrar dene.';
        appendAssistantMessage(message, []);
      } finally {
        window.clearTimeout(timeout);
        isSending = false;
        form.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
        input.removeAttribute('disabled');
        render();
        input.focus();
      }
    });
  }

  function initialMessages(): ChatMessage[] {
    return [{ role: 'assistant', text: INITIAL_MESSAGE }];
  }

  function loadMessages(): ChatMessage[] {
    try {
      const stored = window.sessionStorage.getItem(STORAGE_KEY);
      if (!stored) return initialMessages();
      const parsed = JSON.parse(stored);
      if (!Array.isArray(parsed)) return initialMessages();

      const valid = parsed
        .map((message): ChatMessage | null => {
          if (!message || typeof message !== 'object') return null;
          if (message.role !== 'user' && message.role !== 'assistant') return null;
          if (typeof message.text !== 'string' || !message.text.trim()) return null;
          const results = Array.isArray(message.results)
            ? message.results
                .filter(
                  (result: unknown) =>
                    result &&
                    typeof result === 'object' &&
                    typeof (result as { title?: unknown }).title === 'string' &&
                    typeof (result as { href?: unknown }).href === 'string' &&
                    typeof (result as { meta?: unknown }).meta === 'string',
                )
                .slice(0, 6)
                .map((result: { title: string; href: string; meta: string }) => ({
                  title: result.title,
                  href: result.href,
                  meta: result.meta,
                }))
            : undefined;

          return {
            role: message.role,
            text: message.text.slice(0, MAX_INPUT_LENGTH),
            results,
          };
        })
        .filter((message): message is ChatMessage => Boolean(message));

      return valid.length > 0 ? trimMessages(valid) : initialMessages();
    } catch {
      return initialMessages();
    }
  }

  function persistMessages(): void {
    try {
      window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(messages.slice(-MAX_MESSAGES)));
    } catch {
      setError('Bu tarayıcı oturum geçmişini kaydedemiyor.');
    }
  }

  function appendAssistantMessage(text: string, results: ChatResponse['results']): void {
    const safeText = typeof text === 'string' && text.trim()
      ? text.slice(0, 2000)
      : 'Pingo şu anda yanıt veremiyor. Lütfen biraz sonra tekrar dene.';

    messages = trimMessages([
      ...messages,
      {
        role: 'assistant',
        text: safeText,
        results: sanitizeResults(results),
      },
    ]);
    persistMessages();
    render();
  }

  function trimMessages(value: ChatMessage[]): ChatMessage[] {
    return value.slice(-MAX_MESSAGES);
  }

  function render(): void {
    renderMessages();
    renderLatestResults();
    updateResultCount();
  }

  function renderMessages(): void {
    if (!log) return;
    log.replaceChildren();

    for (const message of messages) {
      const item = document.createElement('article');
      item.className = `assistant-message ${message.role}`;

      const text = document.createElement('p');
      text.textContent = message.text;
      item.append(text);

      if (message.results?.length) {
        const results = document.createElement('div');
        results.className = 'assistant-results';

        for (const result of message.results) {
          const link = document.createElement('a');
          link.href = result.href;

          const title = document.createElement('strong');
          title.textContent = result.title;

          const meta = document.createElement('span');
          meta.textContent = result.meta;

          link.append(title, meta);
          results.append(link);
        }

        item.append(results);
      }

      log.append(item);
    }

    if (isSending) {
      const typing = document.createElement('article');
      typing.className = 'assistant-message assistant';
      const text = document.createElement('p');
      text.className = 'assistant-typing';
      text.textContent = 'Aranıyor...';
      typing.append(text);
      log.append(typing);
    }

    log.scrollTop = log.scrollHeight;
  }

  function renderLatestResults(): void {
    if (!resultsPanel) return;
    resultsPanel.replaceChildren();

    const results = latestResults();
    if (!results.length) {
      const empty = document.createElement('p');
      empty.className = 'assistant-results-empty';
      empty.textContent = 'Henüz sonuç yok. Sohbette nasıl bir oyun aradığını yazınca burada bağlantılar birikir.';
      resultsPanel.append(empty);
      return;
    }

    for (const result of results) {
      const link = document.createElement('a');
      link.href = result.href;

      const title = document.createElement('strong');
      title.textContent = result.title;

      const meta = document.createElement('span');
      meta.textContent = result.meta;

      link.append(title, meta);
      resultsPanel.append(link);
    }
  }

  function latestResults(): NonNullable<ChatMessage['results']> {
    const seen = new Set<string>();
    const results: NonNullable<ChatMessage['results']> = [];

    for (const message of [...messages].reverse()) {
      for (const result of message.results ?? []) {
        if (seen.has(result.href)) continue;
        seen.add(result.href);
        results.push(result);
        if (results.length >= 8) return results;
      }
    }

    return results;
  }

  function updateResultCount(): void {
    if (!resultCount) return;
    resultCount.textContent = String(latestResults().length);
  }

  function setActiveTab(tab: typeof activeTab): void {
    activeTab = tab;

    for (const button of tabButtons) {
      const selected = button.dataset.assistantTab === tab;
      button.setAttribute('aria-selected', String(selected));
    }

    for (const item of tabPanels) {
      item.hidden = item.dataset.assistantPanel !== tab;
    }
  }

  function setError(message: string): void {
    if (!error) return;
    error.textContent = message;
  }

  function isChatResponse(value: unknown): value is ChatResponse {
    if (!value || typeof value !== 'object') return false;
    const candidate = value as Partial<ChatResponse>;
    return typeof candidate.reply === 'string' && Array.isArray(candidate.results);
  }

  function sanitizeResults(results: ChatResponse['results'] | undefined): NonNullable<ChatMessage['results']> {
    if (!Array.isArray(results)) return [];

    return results
      .filter(
        (result) =>
          result &&
          typeof result === 'object' &&
          typeof result.title === 'string' &&
          typeof result.href === 'string' &&
          typeof result.meta === 'string',
      )
      .slice(0, 8)
      .map((result) => ({
        title: result.title.slice(0, 160),
        href: result.href.startsWith('/metin-bankasi/') ? result.href : '/metin-bankasi',
        meta: result.meta.slice(0, 240),
      }));
  }
</script>
