---
import '@/styles/global.css';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = 'SUOyuncuları',
  description = 'Sabancı University theatre club archive, plays, notes, and announcements.',
  image = '/images/theatre-hero.png',
} = Astro.props;

const siteName = 'SUOyuncuları';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://suoyunculari.com');
const imageUrl = new URL(image, canonicalUrl);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0d0d0f" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TheaterGroup',
      name: siteName,
      url: 'https://suoyunculari.com',
      sameAs: [
        'https://www.instagram.com/suoyunculari/',
        'https://www.youtube.com/@suo-yunculari',
        'https://www.tiktok.com/@suoyuncularii',
      ],
    })} />
  </head>
  <body>
    <header class="site-header" data-site-header>
      <a class="brand" href="/" aria-label="SUOyuncuları ana sayfa">
        <img class="brand-logo" src="/Logo.svg" alt="" />
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <div class="site-nav-links" id="site-nav-links">
          <a href="/oyunlarimiz">Oyunlarımız</a>
          <a href="/metin-bankasi">Metin Bankası</a>
          <a href="/kutuphane">Kütüphane</a>
          <a href="/prova-defteri">Prova Defteri</a>
          <a href="/blog">Blog</a>
        </div>
        <div class="site-socials" aria-label="Social links">
          <a class="social-link" href="https://www.instagram.com/suoyunculari/" target="_blank" rel="noreferrer" aria-label="Instagram">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.7 2.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7.2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Zm0 2a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6Z" />
            </svg>
          </a>
          <a class="social-link" href="https://www.youtube.com/@suo-yunculari" target="_blank" rel="noreferrer" aria-label="YouTube">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.6 4.6 12 4.6 12 4.6s-5.6 0-7.5.5a3 3 0 0 0-2.1 2.1A31.2 31.2 0 0 0 2 12a31.2 31.2 0 0 0 .4 4.8 3 3 0 0 0 2.1 2.1c1.9.5 7.5.5 7.5.5s5.6 0 7.5-.5a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 22 12a31.2 31.2 0 0 0-.4-4.8ZM10 15.5v-7l6 3.5-6 3.5Z" />
            </svg>
          </a>
          <a class="social-link" href="https://www.tiktok.com/@suoyuncularii" target="_blank" rel="noreferrer" aria-label="TikTok">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M16.7 2c.3 2.4 1.6 3.9 3.9 4.1v3.4a7.7 7.7 0 0 1-3.8-1v6.6c0 4.2-2.7 6.9-6.7 6.9-3.5 0-6.4-2.4-6.4-5.9 0-3.8 2.9-6.1 6.8-5.9v3.5c-1.7-.2-3 .6-3 2.2 0 1.4 1.1 2.3 2.5 2.3 1.6 0 2.7-.9 2.7-3V2h4Z" />
            </svg>
          </a>
        </div>
      </nav>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav-links" aria-label="Menüyü aç">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>SUOyuncuları</strong>
        <span>Tiyatro kulübü arşivi, prova notları ve duyuruları.</span>
        <span>Made by Ege with {'<3'}</span>
      </div>
      <div class="footer-links" aria-label="Sitemap">
        <a href="/oyunlarimiz">Oyunlarımız</a>
        <a href="/metin-bankasi">Metin Bankası</a>
        <a href="/kutuphane">Kütüphane</a>
        <a href="/prova-defteri">Prova Defteri</a>
        <a href="/blog">Blog</a>
        <a href="/about">Hakkımızda</a>
        <a href="/contact">İletişim</a>
        <a href="/kulup-kaynaklari">Kulüp Kaynakları</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </footer>
    <script is:inline>
      const header = document.querySelector('[data-site-header]');
      const toggle = header?.querySelector('.menu-toggle');
      toggle?.addEventListener('click', () => {
        const open = header.classList.toggle('menu-open');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
      });
    </script>
  </body>
</html>
