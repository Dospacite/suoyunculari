---
import '@/styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'SU Oyunculari',
  description = 'Sabanci University theatre club archive, plays, notes, and announcements.',
} = Astro.props;

const pageTitle = title === 'SU Oyunculari' ? title : `${title} | SU Oyunculari`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="SU Oyunculari home">
        <img class="brand-logo" src="/Logo.svg" alt="" />
        <span>SUO Tiyatro Kulübü</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/oyunlarimiz">Oyunlarımız</a>
        <a href="/metin-bankasi">Metin Bankası</a>
        <a href="/prova-defteri">Prova Defteri</a>
        <a href="/blog">Blog</a>
        <a class="social-link" href="#" aria-disabled="true">IG</a>
        <a class="social-link" href="#" aria-disabled="true">YT</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <strong>SU Oyunculari</strong>
        <span>Tiyatro kulübü arşivi, prova notları ve duyuruları.</span>
      </div>
      <a href="/contact">İletişim</a>
    </footer>
  </body>
</html>
