---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPageByKey, getPages, textContent } from '@/lib/directus';

const page = getPageByKey(await getPages(), 'about');
const aboutText =
  textContent(page?.content) ||
  'SUOyuncuları, Sabancı Üniversitesi Tiyatro Kulübü olarak tiyatroya ilgi duyan öğrencileri oyun okuma, sahneleme, atölye, prova ve ekip üretimi etrafında bir araya getirir. Kulüp, üyelerine oyunculuk, yönetmenlik, dramaturji, dekor, ışık, ses, kostüm ve organizasyon alanlarında deneyim kazanabilecekleri üretim ortamı sunar.';
const paragraphs = aboutText.split(/\n{2,}/).filter(Boolean);
---

<BaseLayout title="Hakkımızda" description="SUOyuncuları hakkında.">
  <main class="section compact">
    <div class="section-inner split">
      <div class="section-heading">
        <h1>{page?.title || 'Hakkımızda'}</h1>
      </div>
      <div class="prose">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </main>
</BaseLayout>
