---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAuthorBySlug, getPlays } from '@/lib/directus';
import { renderMarkdown } from '@/lib/markdown';

export const prerender = false;

const author = Astro.params.slug ? await getAuthorBySlug(Astro.params.slug) : undefined;
if (!author) Astro.response.status = 404;
const plays = author ? (await getPlays()).filter((play) => play.author?.slug === author.slug) : [];
const bioHtml = renderMarkdown(author?.bio);
---

<BaseLayout title={author?.name ?? 'Author not found'} description={author?.bio}>
  <main class="section compact">
    {
      author ? (
        <article class="section-inner">
          <div class="section-heading">
            <h1>{author.name}</h1>
          </div>
          {bioHtml && <div class="prose markdown-content" set:html={bioHtml} />}

          <section class="section-heading" style="margin-top: 56px;">
            <h2>In the archive</h2>
          </section>
          <div class="article-list">
            {plays.length > 0 ? (
              plays.map((play) => (
                <a href={`/plays/${play.slug}`}>
                  <h2>{play.title}</h2>
                  {play.summary && <p>{play.summary}</p>}
                </a>
              ))
            ) : (
              <article>
                <p class="muted">No published play records are linked to this author yet.</p>
              </article>
            )}
          </div>
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <h1>Author not found</h1>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
