---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBlogPostBySlug } from '@/lib/directus';
import { renderMarkdown } from '@/lib/markdown';

export const prerender = false;

const post = Astro.params.slug ? await getBlogPostBySlug(Astro.params.slug) : undefined;
if (!post) Astro.response.status = 404;
const postBodyHtml = renderMarkdown(post?.body);
---

<BaseLayout title={post?.title ?? 'Post not found'} description={post?.excerpt}>
  <main class="section compact">
    {
      post ? (
        <article class="section-inner">
          <div class="section-heading">
            <h1>{post.title}</h1>
          </div>
          {postBodyHtml && <div class="prose markdown-content" set:html={postBodyHtml} />}

          {post.related_plays && post.related_plays.length > 0 && (
            <section class="related-section" aria-labelledby="related-plays-heading">
              <p class="kicker" id="related-plays-heading">Oyunlarımız</p>
              <div class="article-list compact-list">
                {post.related_plays.map((play) => (
                  <a href={`/plays/${play.slug}`}>
                    {play.author?.name && <p class="kicker">{play.author.name}</p>}
                    <h2>{play.title}</h2>
                    {play.summary && <p>{play.summary}</p>}
                  </a>
                ))}
              </div>
            </section>
          )}

          {post.text_bank_references && post.text_bank_references.length > 0 && (
            <section class="related-section" aria-labelledby="related-text-bank-heading">
              <p class="kicker" id="related-text-bank-heading">Metin Bankası</p>
              <div class="article-list compact-list">
                {post.text_bank_references.map((reference) => (
                  <a
                    href={`/metin-bankasi/${encodeURIComponent(reference.source || '')}/${encodeURIComponent(
                      reference.source_id || '',
                    )}`}
                  >
                    {reference.source && <p class="kicker">{reference.source.replaceAll('_', ' ')}</p>}
                    {(reference.title || reference.source_id) && <h2>{reference.title || reference.source_id}</h2>}
                    {reference.source_url && <p>{reference.source_url}</p>}
                  </a>
                ))}
              </div>
            </section>
          )}

          {post.related_books && post.related_books.length > 0 && (
            <section class="related-section" aria-labelledby="related-books-heading">
              <p class="kicker" id="related-books-heading">Kütüphane</p>
              <div class="article-list compact-list">
                {post.related_books.map((book) => (
                  <article>
                    {book.category && <p class="kicker">{book.category}</p>}
                    <h2>{book.title}</h2>
                    {[book.author, book.publisher, book.location].filter(Boolean).length > 0 && (
                      <p>{[book.author, book.publisher, book.location].filter(Boolean).join(' / ')}</p>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )}
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <h1>Post not found</h1>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
