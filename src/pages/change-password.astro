---
import YkLayout from '@/layouts/YkLayout.astro';

const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
---

<YkLayout title="Şifre değiştir" user={user}>
  <section class="auth-panel">
    <div>
      <h1>Şifre değiştir</h1>
      <p>Geçici şifreyle devam etmeden önce yeni bir şifre belirle.</p>
    </div>
    {error === 'invalid' && <p class="error">Yeni şifreler eşleşmeli ve en az 10 karakter olmalı.</p>}
    {error === 'current' && <p class="error">Mevcut şifre hatalı.</p>}
    <form class="panel" method="post" action="/api/auth/change-password">
      <label>
        Mevcut şifre
        <input name="current_password" type="password" autocomplete="current-password" required />
      </label>
      <label>
        Yeni şifre
        <input name="password" type="password" autocomplete="new-password" minlength="10" required />
      </label>
      <label>
        Yeni şifre tekrar
        <input name="confirm" type="password" autocomplete="new-password" minlength="10" required />
      </label>
      <button type="submit">Şifreyi güncelle</button>
    </form>
  </section>
</YkLayout>
