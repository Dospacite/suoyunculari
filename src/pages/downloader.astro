---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="İndirici" description="Scribd PDF indirici.">
  <main>
    <section class="section compact downloader-page">
      <div class="section-inner downloader-shell">
        <div class="section-heading">
          <h1>İndirici</h1>
        </div>

        <form class="downloader-form" data-downloader-form>
          <label>
            <span>Scribd belge bağlantısı</span>
            <input data-url-input type="url" placeholder="https://www.scribd.com/document/..." required />
          </label>
          <div class="downloader-options">
            <button class="button" type="submit" data-submit-button>PDF oluştur</button>
          </div>
        </form>

        <div class="downloader-status" aria-live="polite">
          <div class="downloader-progress-row">
            <div class="downloader-meter">
              <span data-progress-bar></span>
            </div>
            <button class="button" type="button" data-cancel-button disabled>İptal</button>
          </div>
          <p data-status-text></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const form = document.querySelector('[data-downloader-form]');
  const urlInput = document.querySelector('[data-url-input]');
  const submitButton = document.querySelector('[data-submit-button]');
  const cancelButton = document.querySelector('[data-cancel-button]');
  const statusText = document.querySelector('[data-status-text]');
  const progressBar = document.querySelector('[data-progress-bar]');

  let activeJobId = null;
  let activeSocket = null;
  let activeDownloadUrl = null;

  const setStatus = (message) => {
    statusText.textContent = message;
  };

  const setBusy = (busy) => {
    submitButton.disabled = busy;
    cancelButton.disabled = !busy;
  };

  const cleanupDownloadUrl = () => {
    if (activeDownloadUrl) {
      URL.revokeObjectURL(activeDownloadUrl);
      activeDownloadUrl = null;
    }
  };

  const filenameFromDisposition = (value) => {
    const match = String(value || '').match(/filename="([^"]+)"/);
    return match ? match[1] : 'scribd-document.pdf';
  };

  const cancelActiveJob = () => {
    if (!activeJobId && !activeSocket) return;
    closeSocket();
    activeJobId = null;
  };

  const closeSocket = () => {
    activeSocket?.close();
    activeSocket = null;
  };

  const downloadResult = async (jobId) => {
    const response = await fetch(`/api/downloader?id=${encodeURIComponent(jobId)}`);
    if (!response.ok) {
      const payload = await response.json().catch(() => ({}));
      throw new Error(payload.error || `İndirici HTTP ${response.status} döndürdü.`);
    }

    const pdf = await response.blob();
    cleanupDownloadUrl();
    activeDownloadUrl = URL.createObjectURL(pdf);
    const link = document.createElement('a');
    link.href = activeDownloadUrl;
    link.download = filenameFromDisposition(response.headers.get('Content-Disposition'));
    link.click();
    setStatus(link.download);
  };

  const bindSocket = () => {
    closeSocket();
    const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
    activeSocket = new WebSocket(`${protocol}://${window.location.host}/api/downloader/ws`);
    const updateProgress = (payload) => {
      const progress = payload.progress || {};
      progressBar.style.width = `${progress.percent || 0}%`;
      setStatus(progress.stage || payload.status || '');
    };

    activeSocket.addEventListener('open', () => {
      activeSocket.send(JSON.stringify({
        type: 'start',
        url: urlInput.value.trim(),
        includeText: true,
      }));
    });

    activeSocket.addEventListener('message', async (event) => {
      const message = JSON.parse(event.data);
      const payload = message.payload || {};

      if (message.type === 'job') {
        activeJobId = payload.id;
        updateProgress(payload);
        return;
      }

      if (message.type === 'status' || message.type === 'progress') {
        updateProgress(payload);
        return;
      }

      if (message.type === 'complete') {
        updateProgress(payload);
        try {
          await downloadResult(payload.id);
          closeSocket();
          activeJobId = null;
        } catch (error) {
          closeSocket();
          setStatus(`Hata: ${error.message || error}`);
          progressBar.style.width = '0';
          activeJobId = null;
        } finally {
          setBusy(false);
        }
        return;
      }

      if (message.type === 'error') {
        closeSocket();
        activeJobId = null;
        setBusy(false);
        setStatus(`Hata: ${payload.error || payload.status || 'İndirici hatası.'}`);
        progressBar.style.width = '0';
        return;
      }

      if (message.type === 'cancelled') {
        closeSocket();
        activeJobId = null;
        setBusy(false);
        setStatus(payload.error || 'İndirme iptal edildi.');
        progressBar.style.width = '0';
      }
    });

    activeSocket.addEventListener('error', () => {
      setBusy(false);
      setStatus('Hata: WebSocket bağlantısı kurulamadı.');
      progressBar.style.width = '0';
    });

    activeSocket.addEventListener('close', () => {
      activeSocket = null;
    });
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    cancelActiveJob();
    cleanupDownloadUrl();
    setBusy(true);
    progressBar.style.width = '0';
    setStatus('Sıraya alındı');
    bindSocket();
  });

  cancelButton.addEventListener('click', () => {
    cancelActiveJob();
    setBusy(false);
    progressBar.style.width = '0';
    setStatus('İptal edildi');
  });

  window.addEventListener('pagehide', () => {
    cancelActiveJob();
    cleanupDownloadUrl();
  });
</script>
