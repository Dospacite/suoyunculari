---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assetUrl, getBlogPosts, getHomePlays, getHomepageSections } from '@/lib/directus';

export const prerender = false;

const homePlays = await getHomePlays();
const latestPosts = (await getBlogPosts()).slice(0, 3);
const homepageSections = await getHomepageSections();
const heroSection = homepageSections.find((section) => section.section_key === 'hero');
const heroImage = assetUrl(heroSection?.image);
const heroHeading = heroSection?.heading || 'SUO Tiyatro Kulübü';
const heroHeadingRemainder = heroHeading.replace(/^SUO\s*/i, '').trim();
const shouldUseLogoHeading = /^SUO(\s|$)/i.test(heroHeading);

const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  hour: '2-digit',
  minute: '2-digit',
});

const postDateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title="SUOyuncuları" description="SUO Tiyatro Kulübü oyunları, metin bankası ve prova defteri.">
  <main>
    <section
      class="home-hero"
      id="top"
      style={heroImage ? `--hero-image: url("${heroImage}")` : undefined}
    >
      <div class="hero-title">
        <p>{heroSection?.subheading || 'Sabancı Üniversitesi'}</p>
        <h1 class:list={[shouldUseLogoHeading && 'logo-heading']}>
          {shouldUseLogoHeading ? (
            <>
              <img src="/Logo.svg" alt="SUO" />
              {heroHeadingRemainder && <span>{heroHeadingRemainder}</span>}
            </>
          ) : (
            heroHeading
          )}
        </h1>
      </div>
      <a class="scroll-cue" href="#yaklasan-oyunlar">KEŞFET</a>
    </section>

    <section class="section home-section" id="yaklasan-oyunlar">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="kicker">Program</p>
          <h2>Yaklaşan Oyunlar</h2>
        </div>
        <div
          class:list={['home-play-grid', homePlays.length > 0 && homePlays.length < 3 && 'centered']}
          style={`--home-play-count: ${Math.max(1, Math.min(homePlays.length, 3))}`}
        >
          {homePlays.map((play) => {
            const image = assetUrl(play.home_card_image || play.cover_image);
            const date = play.event_date ? dateFormatter.format(new Date(play.event_date)) : 'Tarih yakında';

            return (
              <article class="home-play-card">
                {image ? (
                  <img src={image} alt="" loading="lazy" />
                ) : (
                  <div class="home-card-fallback" aria-hidden="true" />
                )}
                <div>
                  <p class="kicker">{date}</p>
                  <h3>{play.title}</h3>
                  <p>{play.summary}</p>
                  <div class="home-card-meta">
                    <span>{play.event_venue || 'Mekan yakında'}</span>
                    <a class="button compact-button" href={`/plays/${play.slug}`}>DETAY</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section home-section" id="son-yazilar">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="kicker">Blog</p>
          <h2>Son Yazılar</h2>
        </div>
        {latestPosts.length > 0 ? (
          <div
            class:list={['home-play-grid', latestPosts.length > 0 && latestPosts.length < 3 && 'centered']}
            style={`--home-play-count: ${Math.max(1, Math.min(latestPosts.length, 3))}`}
          >
            {latestPosts.map((post) => {
              const image = assetUrl(post.cover_image);
              const date = post.published_at
                ? postDateFormatter.format(new Date(post.published_at))
                : 'Yayın tarihi yok';

              return (
                <article class="home-play-card home-blog-card">
                  {image ? (
                    <img src={image} alt="" loading="lazy" />
                  ) : (
                    <div class="home-card-fallback blog-fallback" aria-hidden="true" />
                  )}
                  <div>
                    <p class="kicker">{date}</p>
                    <h3>{post.title}</h3>
                    <p>{post.excerpt}</p>
                    <div class="home-card-meta">
                      <span>{post.author_name || 'SUOyuncuları'}</span>
                      <a class="button compact-button" href={`/blog/${post.slug}`}>OKU</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <p class="empty-state center-empty">Yayınlanmış blog yazısı henüz yok.</p>
        )}
      </div>
    </section>

    <section class="section tool-section">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="kicker">Arşiv</p>
          <h2>Araçlar</h2>
        </div>
        <div class="tool-grid">
          <a class="tool-tile blue" href="/oyunlarimiz">
            <span>Oyunlarımız</span>
            <strong>Kulüp arşivini gör</strong>
          </a>
          <a class="tool-tile red" href="/metin-bankasi">
            <span>Metin Bankası</span>
            <strong>Concord ve Drama Online metinlerini ara</strong>
          </a>
          <a class="tool-tile white" href="/kutuphane">
            <span>Kütüphane</span>
            <strong>Fiziksel kitaplığı tara</strong>
          </a>
          <a class="tool-tile black" href="/prova-defteri">
            <span>Prova Defteri</span>
            <strong>Egzersiz ve fikir bul</strong>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
