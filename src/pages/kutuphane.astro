---
import BookList from '@/components/BookList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBooks } from '@/lib/directus';

export const prerender = false;

const books = await getBooks();
---

<BaseLayout title="Kütüphane" description="SUOyuncuları fiziksel kitap arşivi.">
  <main class="section compact">
    <div class="section-inner">
      <div class="section-heading">
        <p class="kicker">Kitaplık</p>
        <h1>Kütüphane</h1>
        <p>Kulübün fiziksel kitaplığındaki tiyatro, oyunculuk, dramaturji ve sahneleme kaynaklarını ara.</p>
      </div>
      <BookList books={books} />
    </div>
  </main>
</BaseLayout>
