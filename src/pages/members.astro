---
import YkLayout from '@/layouts/YkLayout.astro';
import { getRollCallData, listSheets } from '@/lib/yk';

const user = Astro.locals.user!;
const sheets = await listSheets();
const selectedId = Astro.url.searchParams.get('sheet') || sheets[0]?.id || '';
const data = selectedId ? await getRollCallData(selectedId) : null;
---

<YkLayout title="Üyeler" user={user}>
  <header class="page-head">
    <h1>Üyeler</h1>
  </header>

  {
    data ? (
      <section class="split">
        <div class="panel">
          <div class="toolbar">
            <label>
              Çizelge
              <select id="sheet-select">
                {sheets.map((sheet) => <option value={sheet.id} selected={sheet.id === selectedId}>{sheet.name}</option>)}
              </select>
            </label>
          </div>
          <div class="user-list">
            {data.members.map((member) => (
              <form class="user-row" data-member-form data-id={member.id}>
                <label>
                  Ad
                  <input name="first_name" value={member.first_name} required />
                </label>
                <label>
                  Soyad
                  <input name="last_name" value={member.last_name} required />
                </label>
                <label>
                  Not
                  <input name="notes" value={member.notes || ''} />
                </label>
                <div class="form-row">
                  <button type="submit">Kaydet</button>
                  <button class="danger" type="button" data-delete-member data-id={member.id}>Sil</button>
                </div>
              </form>
            ))}
          </div>
        </div>
        <form class="panel" data-add-member data-sheet={data.sheet.id}>
          <h2>Üye ekle</h2>
          <label>
            Ad
            <input name="firstName" required />
          </label>
          <label>
            Soyad
            <input name="lastName" required />
          </label>
          <label>
            Not
            <input name="notes" />
          </label>
          <button type="submit">Ekle</button>
        </form>
      </section>
    ) : (
      <section class="panel"><p>Önce bir yoklama çizelgesi oluştur.</p></section>
    )
  }

  <script>
    // @ts-nocheck
    const postJson = async (url, method, body = undefined) => {
      const response = await fetch(url, {
        method,
        headers: { 'content-type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!response.ok) throw new Error('İşlem başarısız');
      return response.json().catch(() => ({}));
    };

    document.querySelector('#sheet-select')?.addEventListener('change', (event) => {
      window.location.href = `/members?sheet=${encodeURIComponent(event.currentTarget.value)}`;
    });

    document.querySelectorAll('[data-member-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        await postJson(`/api/roll-call/members/${form.dataset.id}`, 'PATCH', Object.fromEntries(new FormData(form).entries()));
        window.location.reload();
      });
    });

    document.querySelectorAll('[data-delete-member]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!confirm('Üye pasifleştirilsin mi?')) return;
        await postJson(`/api/roll-call/members/${button.dataset.id}`, 'DELETE');
        window.location.reload();
      });
    });

    document.querySelector('[data-add-member]')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      await postJson(`/api/roll-call/sheets/${form.dataset.sheet}/members`, 'POST', Object.fromEntries(new FormData(form).entries()));
      window.location.reload();
    });
  </script>
</YkLayout>
