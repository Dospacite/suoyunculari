---
import YkLayout from '@/layouts/YkLayout.astro';
import { listMembers, listSeasons } from '@/lib/yk';

const user = Astro.locals.user!;
const seasons = await listSeasons();
const selectedSeasonId = Astro.url.searchParams.get('season') || seasons.find((season) => !season.archived)?.id || seasons[0]?.id || '';
const selectedSort = Astro.url.searchParams.get('sort') === 'total' ? 'total' : Astro.url.searchParams.get('sort') === 'name' ? 'name' : 'manual';
const members = selectedSeasonId ? await listMembers(selectedSeasonId, selectedSort) : [];
---

<YkLayout title="Üyeler" user={user}>
  <header class="page-head">
    <h1>Üyeler</h1>
  </header>

  {
    seasons.length === 0 ? (
      <section class="panel">
        <h2>Sezon yok</h2>
        <p>Üye eklemek için önce Sezonlar ekranından sezon oluştur.</p>
      </section>
    ) : (
      <section class="split">
        <div class="panel">
          <div class="toolbar">
            <label>
              Sezon
              <select id="season-select">
                {seasons.map((season) => <option value={season.id} selected={season.id === selectedSeasonId}>{season.name}</option>)}
              </select>
            </label>
            <label>
              Sıralama
              <select id="sort-select">
                <option value="manual" selected={selectedSort === 'manual'}>Elle sıralama</option>
                <option value="name" selected={selectedSort === 'name'}>Ada göre</option>
                <option value="total" selected={selectedSort === 'total'}>Toplam puana göre</option>
              </select>
            </label>
            <button class="secondary" type="button" data-save-order disabled={selectedSort !== 'manual'}>Sırayı kaydet</button>
          </div>
          <div class="member-list" data-member-list data-season={selectedSeasonId}>
            {members.map((member) => (
              <form class="member-row" data-member-form data-id={member.id} draggable={selectedSort === 'manual'}>
                <span class="drag-handle" aria-hidden="true">☰</span>
                <label>
                  Ad
                  <input name="first_name" value={member.first_name} required />
                </label>
                <label>
                  Soyad
                  <input name="last_name" value={member.last_name} required />
                </label>
                {'total_points' in member && <span class="member-sub">Toplam: {(member as any).total_points}</span>}
                <div class="form-row">
                  <a class="button secondary" href={`/members/${member.id}`}>Detay</a>
                  <button type="submit">Kaydet</button>
                  <button class="danger" type="button" data-delete-member data-id={member.id}>Sil</button>
                </div>
              </form>
            ))}
          </div>
        </div>
        <form class="panel" data-add-member data-season={selectedSeasonId}>
          <h2>Üye ekle</h2>
          <label>
            Ad
            <input name="firstName" required />
          </label>
          <label>
            Soyad
            <input name="lastName" required />
          </label>
          <button type="submit">Ekle</button>
        </form>
      </section>
    )
  }

  <script>
    // @ts-nocheck
    const postJson = async (url, method, body = undefined) => {
      const response = await fetch(url, {
        method,
        headers: { 'content-type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!response.ok) throw new Error('İşlem başarısız');
      return response.json().catch(() => ({}));
    };

    document.querySelector('#season-select')?.addEventListener('change', (event) => {
      window.location.href = `/members?season=${encodeURIComponent(event.currentTarget.value)}&sort=${encodeURIComponent(document.querySelector('#sort-select')?.value || 'manual')}`;
    });

    document.querySelector('#sort-select')?.addEventListener('change', (event) => {
      window.location.href = `/members?season=${encodeURIComponent(document.querySelector('#season-select')?.value || '')}&sort=${encodeURIComponent(event.currentTarget.value)}`;
    });

    document.querySelectorAll('[data-member-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        await postJson(`/api/roll-call/members/${form.dataset.id}`, 'PATCH', Object.fromEntries(new FormData(form).entries()));
        window.location.reload();
      });
    });

    document.querySelectorAll('[data-delete-member]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!confirm('Üye pasifleştirilsin mi?')) return;
        await postJson(`/api/roll-call/members/${button.dataset.id}`, 'DELETE');
        window.location.reload();
      });
    });

    document.querySelector('[data-add-member]')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      await postJson(`/api/seasons/${form.dataset.season}/members`, 'POST', Object.fromEntries(new FormData(form).entries()));
      window.location.reload();
    });

    const memberList = document.querySelector('[data-member-list]');
    let dragged = null;
    memberList?.querySelectorAll('[data-member-form]').forEach((row) => {
      row.addEventListener('dragstart', () => {
        dragged = row;
        row.classList.add('dragging');
      });
      row.addEventListener('dragend', () => {
        row.classList.remove('dragging');
        dragged = null;
      });
      row.addEventListener('dragover', (event) => {
        if (!dragged || dragged === row) return;
        event.preventDefault();
        const rect = row.getBoundingClientRect();
        const after = event.clientY > rect.top + rect.height / 2;
        row.parentNode.insertBefore(dragged, after ? row.nextSibling : row);
      });
    });

    document.querySelector('[data-save-order]')?.addEventListener('click', async () => {
      if (!memberList) return;
      const memberIds = Array.from(memberList.querySelectorAll('[data-member-form]')).map((row) => row.dataset.id);
      await postJson(`/api/seasons/${memberList.dataset.season}/members`, 'PATCH', { memberIds });
      window.location.reload();
    });
  </script>
</YkLayout>
