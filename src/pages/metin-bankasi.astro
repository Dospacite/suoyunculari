---
import ConcordPlayList from '@/components/ConcordPlayList.astro';
import TextBankAssistant from '@/components/TextBankAssistant.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="Metin Bankası" description="Concord ve Drama Online kaynaklı oyun metni arşivi.">
  <main class="section compact">
    <div class="section-inner">
      <div class="section-heading">
        <p class="kicker">Concord + Drama Online</p>
        <h1>Metin Bankası</h1>
        <p>Concord Theatricals ve Drama Online oyun/müzikal kayıtlarını başlık, yazar, kaynak, tür, süre, kadro, tema ve performans ihtiyacına göre ara.</p>
      </div>
      <ConcordPlayList />
      <TextBankAssistant />
    </div>
  </main>
</BaseLayout>
