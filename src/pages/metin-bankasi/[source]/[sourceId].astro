---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getConcordPlayBySourceId } from '@/lib/concord-db';
import { getRelatedBlogPostsForTextBank } from '@/lib/directus';

export const prerender = false;

const source = Astro.params.source ? decodeURIComponent(Astro.params.source) : '';
const sourceId = Astro.params.sourceId ? decodeURIComponent(Astro.params.sourceId) : '';
const play = source && sourceId ? await getConcordPlayBySourceId(source, sourceId) : undefined;
const relatedPosts = play ? await getRelatedBlogPostsForTextBank(play.source, play.source_id) : [];

if (!play) Astro.response.status = 404;

const sourceLabels: Record<string, string> = {
  concord_theatricals: 'Concord',
  drama_online_library: 'Drama Online',
};

const sourceLabel = play?.source ? (sourceLabels[play.source] ?? play.source) : undefined;
const authorText = play?.authors?.map((author) => author.name).filter(Boolean).join(', ');
const duration = play?.duration_text || (play?.duration_minutes ? `${play.duration_minutes} dk` : undefined);
const noteItems = [...(play?.themes ?? []), ...(play?.features ?? [])];
const taxonomyItems = [...(play?.genres ?? []), ...(play?.tags ?? [])];
---

<BaseLayout title={play?.title ?? 'Metin bulunamadı'} description={play?.summary_text}>
  <main class="section compact">
    {
      play ? (
        <article class="section-inner">
          <div class="section-heading">
            <h1>{play.title}</h1>
            {play.source_url && (
              <a class="button detail-source-button" href={play.source_url} target="_blank" rel="noreferrer">
                {`See in ${sourceLabel}`}
              </a>
            )}
          </div>

          <div class="detail-meta">
            {authorText && (
              <div>
                <dt>Yazar</dt>
                <dd>{authorText}</dd>
              </div>
            )}
            {play.casting_text && (
              <div>
                <dt>Kadro</dt>
                <dd>{play.casting_text}</dd>
              </div>
            )}
            {duration && (
              <div>
                <dt>Süre</dt>
                <dd>{duration}</dd>
              </div>
            )}
            {sourceLabel && (
              <div>
                <dt>Kaynak</dt>
                <dd>{sourceLabel}</dd>
              </div>
            )}
          </div>

          <div class="split">
            {(play.rights_status || play.licensing_fee_text) && (
              <div>
                <p class="kicker">Haklar</p>
                {play.rights_status && <p class="prose">{play.rights_status}</p>}
                {play.licensing_fee_text && <p class="prose">{play.licensing_fee_text}</p>}
              </div>
            )}
            {(noteItems.length > 0 || taxonomyItems.length > 0) && (
              <div>
                {noteItems.length > 0 && (
                  <>
                    <p class="kicker">Notlar</p>
                    <p class="prose">{noteItems.join(', ')}</p>
                  </>
                )}
                {taxonomyItems.length > 0 && (
                  <div class="taxonomy">
                    {taxonomyItems.map((item) => <span>{item}</span>)}
                  </div>
                )}
              </div>
            )}
          </div>

          {relatedPosts.length > 0 && (
            <section class="related-section" aria-labelledby="related-blog-heading">
              <p class="kicker" id="related-blog-heading">Blog</p>
              <div class="article-list compact-list">
                {relatedPosts.map((post) => (
                  <a href={`/blog/${post.slug}`}>
                    {post.author_name && <p class="kicker">{post.author_name}</p>}
                    <h2>{post.title}</h2>
                    {post.excerpt && <p>{post.excerpt}</p>}
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <h1>Metin bulunamadı</h1>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
