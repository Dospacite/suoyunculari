---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPlayBySlug, getRelatedBlogPostsForPlay } from '@/lib/directus';

export const prerender = false;

const play = Astro.params.slug ? await getPlayBySlug(Astro.params.slug) : undefined;
const relatedPosts = play ? await getRelatedBlogPostsForPlay(play.slug) : [];
if (!play) Astro.response.status = 404;
const genres = play?.genres?.map((genre) => genre.name) ?? [];
const tags = play?.tags?.map((tag) => tag.name) ?? [];
---

<BaseLayout title={play?.title ?? 'Play not found'} description={play?.summary}>
  <main class="section compact">
    {
      play ? (
        <article class="section-inner">
          <div class="section-heading">
            <p class="kicker">{genres.join(', ') || 'Play'}</p>
            <h1>{play.title}</h1>
            <p>{play.summary}</p>
            {play.text_bank_source && play.text_bank_source_id && (
              <a
                class="button detail-source-button"
                href={`/metin-bankasi/${encodeURIComponent(play.text_bank_source)}/${encodeURIComponent(
                  play.text_bank_source_id,
                )}`}
              >
                Metin Bankası Detayı
              </a>
            )}
          </div>

          <div class="detail-meta">
            <div>
              <dt>Author</dt>
              <dd>{play.author?.name || 'Unknown'}</dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd>{play.year_written || 'TBD'}</dd>
            </div>
            <div>
              <dt>Duration</dt>
              <dd>{play.duration_minutes ? `${play.duration_minutes} min` : 'TBD'}</dd>
            </div>
            <div>
              <dt>Cast</dt>
              <dd>
                {play.min_cast_size && play.max_cast_size
                  ? `${play.min_cast_size}-${play.max_cast_size}`
                  : 'Flexible'}
              </dd>
            </div>
          </div>

          <div class="split">
            <div>
              <p class="kicker">Rights</p>
              <p class="prose">{(play.rights_status || 'unknown').replaceAll('_', ' ')}</p>
              {play.rights_notes && <p class="prose">{play.rights_notes}</p>}
            </div>
            <div>
              <p class="kicker">Notes</p>
              <p class="prose">
                {play.setting ||
                  play.themes ||
                  'Add rehearsal, setting, theme, and production notes in Directus.'}
              </p>
              <div class="taxonomy">
                {[...genres, ...tags].map((item) => <span>{item}</span>)}
              </div>
            </div>
          </div>

          {relatedPosts.length > 0 && (
            <section class="related-section" aria-labelledby="related-blog-heading">
              <p class="kicker" id="related-blog-heading">Blog</p>
              <div class="article-list compact-list">
                {relatedPosts.map((post) => (
                  <a href={`/blog/${post.slug}`}>
                    <p class="kicker">{post.author_name || 'SU Oyuncuları'}</p>
                    <h2>{post.title}</h2>
                    <p>{post.excerpt}</p>
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <p class="kicker">404</p>
            <h1>Play not found</h1>
            <p>This play is not published or does not exist.</p>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
