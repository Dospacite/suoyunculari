---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  assetUrl,
  getPlayBySlug,
  getRelatedBlogPostsForPlay,
  getStagingsForPlay,
  getTextBankReference,
} from '@/lib/directus';
import { markdownToPlainText, renderMarkdown } from '@/lib/markdown';

export const prerender = false;

const play = Astro.params.slug ? await getPlayBySlug(Astro.params.slug) : undefined;
const stagings = play ? await getStagingsForPlay(play.slug, play) : [];
const relatedPosts = play ? await getRelatedBlogPostsForPlay(play.slug) : [];
if (!play) Astro.response.status = 404;

const nextStaging = stagings.find((staging) => staging.date && new Date(staging.date) >= new Date()) ?? stagings[0];
const textBankReference = getTextBankReference(play);
const castText = play?.cast || nextStaging?.cast_notes;
const posterImage = assetUrl(play?.poster_image || play?.cover_image);
const descriptionHtml = renderMarkdown(play?.summary);
const castHtml = renderMarkdown(castText);
const hasPosterDetails = Boolean(posterImage || play?.event_date || play?.event_venue);
const scriptHref =
  textBankReference?.source && textBankReference.source_id
    ? `/metin-bankasi/${encodeURIComponent(textBankReference.source)}/${encodeURIComponent(
        textBankReference.source_id,
      )}`
    : play?.script_url;
const hasDetailActions = Boolean(scriptHref || nextStaging);

const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const shortDateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={play?.title ?? 'Oyun bulunamadı'} description={play?.summary}>
  <main class="section compact">
    {
      play ? (
        <article class="section-inner">
          <header class="play-detail-hero">
            <div class="play-detail-title">
              <h1>{play.title}</h1>
              {play.author?.name && <p>{play.author.name}</p>}
            </div>
            {hasDetailActions && (
              <div class="play-detail-actions">
                {scriptHref && (
                  <a class="button" href={scriptHref}>
                  Metin Detayı
                  </a>
                )}
                {nextStaging && (
                  <a class="button secondary-button" href={`/plays/${play.slug}/stagings/${nextStaging.slug}`}>
                    Sahneleme Detayı
                  </a>
                )}
              </div>
            )}
          </header>

          <div class="detail-divider"></div>

          {descriptionHtml && (
            <section class="play-description-block">
              <h2>Açıklama</h2>
              <div class="play-description markdown-content" set:html={descriptionHtml} />
            </section>
          )}

          {(castHtml || hasPosterDetails) && (
            <section class="play-production-layout" aria-label="Oyun üretim bilgileri">
              {castHtml && (
                <div class="play-cast-panel">
                  <div>
                    <h2>Kadro</h2>
                    <div class="markdown-content" set:html={castHtml} />
                  </div>
                </div>
              )}
              {hasPosterDetails && (
                <div>
                  <figure class="play-poster">
                    {posterImage && <img src={posterImage} alt="" loading="lazy" />}
                    <figcaption>
                      <strong>{play.title}</strong>
                      {play.event_date && <span>Prömiyer: {shortDateFormatter.format(new Date(play.event_date))}</span>}
                      {play.event_venue && <span>{play.event_venue}</span>}
                    </figcaption>
                  </figure>
                </div>
              )}
            </section>
          )}

          <section class="related-section" aria-label="Sahnelemeler">
            {stagings.length > 0 ? (
              <div class="staging-card-grid">
                {stagings.map((staging) => {
                  const image = assetUrl(staging.cover_image || play.cover_image);
                  const stagingDescription = markdownToPlainText(staging.summary || staging.production_notes);
                  return (
                    <a class="staging-card" href={`/plays/${play.slug}/stagings/${staging.slug}`}>
                      {staging.date && <span class="play-card-year">{dateFormatter.format(new Date(staging.date))}</span>}
                      {image ? <img src={image} alt="" loading="lazy" /> : <div class="play-card-fallback" aria-hidden="true"></div>}
                      <div class="play-card-copy">
                        <h2>{staging.title}</h2>
                        {staging.venue && (
                          <p class="play-card-author location-line">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                              <path d="M12 21s7-5.4 7-12a7 7 0 1 0-14 0c0 6.6 7 12 7 12Zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" />
                            </svg>
                            <span>{staging.venue}</span>
                          </p>
                        )}
                        {stagingDescription && <p class="play-card-description">{stagingDescription}</p>}
                      </div>
                    </a>
                  );
                })}
              </div>
            ) : (
              <p class="empty-state">Bu oyun için yayınlanmış sahneleme kaydı henüz yok.</p>
            )}
          </section>

          {relatedPosts.length > 0 && (
            <section class="related-section" aria-labelledby="related-blog-heading">
              <p class="kicker" id="related-blog-heading">Blog</p>
              <div class="article-list compact-list">
                {relatedPosts.map((post) => (
                  <a href={`/blog/${post.slug}`}>
                    {post.author_name && <p class="kicker">{post.author_name}</p>}
                    <h2>{post.title}</h2>
                    {post.excerpt && <p>{post.excerpt}</p>}
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <h1>Oyun bulunamadı</h1>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
