---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  assetUrl,
  getPlayBySlug,
  getRelatedBlogPostsForPlay,
  getStagingsForPlay,
  getTextBankReference,
} from '@/lib/directus';

export const prerender = false;

const play = Astro.params.slug ? await getPlayBySlug(Astro.params.slug) : undefined;
const stagings = play ? await getStagingsForPlay(play.slug, play) : [];
const relatedPosts = play ? await getRelatedBlogPostsForPlay(play.slug) : [];
if (!play) Astro.response.status = 404;

const genres = play?.genres?.map((genre) => genre.name) ?? [];
const tags = play?.tags?.map((tag) => tag.name) ?? [];
const nextStaging = stagings.find((staging) => staging.date && new Date(staging.date) >= new Date()) ?? stagings[0];
const textBankReference = getTextBankReference(play);
const directorText = play?.director || nextStaging?.director;
const castText = play?.cast || nextStaging?.cast_notes;
const scriptHref =
  textBankReference?.source && textBankReference.source_id
    ? `/metin-bankasi/${encodeURIComponent(textBankReference.source)}/${encodeURIComponent(
        textBankReference.source_id,
      )}`
    : play?.script_url;

const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<BaseLayout title={play?.title ?? 'Oyun bulunamadı'} description={play?.summary}>
  <main class="section compact">
    {
      play ? (
        <article class="section-inner">
          <div class="section-heading">
            <h1>{play.title}</h1>
            <div class="button-row">
              {scriptHref && (
                <a class="button detail-source-button" href={scriptHref}>
                  Metin Detayı
                </a>
              )}
              {nextStaging && (
                <a
                  class="button secondary-button detail-source-button"
                  href={`/plays/${play.slug}/stagings/${nextStaging.slug}`}
                >
                  Sahneleme Detayı
                </a>
              )}
            </div>
          </div>

          <div class="detail-meta">
            <div>
              <dt>Yazar</dt>
              <dd>{play.author?.name || 'Belirsiz'}</dd>
            </div>
            <div>
              <dt>Yönetmen</dt>
              <dd>{directorText || 'Belirsiz'}</dd>
            </div>
            <div>
              <dt>Sahneleme</dt>
              <dd>{stagings.length || 'Yakında'}</dd>
            </div>
            <div>
              <dt>Sıradaki Tarih</dt>
              <dd>{nextStaging?.date ? dateFormatter.format(new Date(nextStaging.date)) : 'Yakında'}</dd>
            </div>
            <div>
              <dt>Mekan</dt>
              <dd>{nextStaging?.venue || play.event_venue || 'Yakında'}</dd>
            </div>
          </div>

          <section class="related-section" aria-labelledby="cast-heading">
            <div class="split">
              <div>
                <p class="kicker" id="cast-heading">Kadro</p>
                <p class="prose">
                  {castText || 'Kadro bilgisi Directus oyun kaydından eklenebilir.'}
                </p>
              </div>
              <div>
                <p class="kicker">Yönetmen</p>
                <p class="prose">{directorText || 'Yönetmen bilgisi Directus oyun kaydından eklenebilir.'}</p>
              </div>
            </div>
          </section>

          <section class="related-section" aria-labelledby="stagings-heading">
            <div class="section-heading small-heading">
              <h2>Gösterim ve Üretim Notları</h2>
            </div>

            {stagings.length > 0 ? (
              <div class="article-list compact-list">
                {stagings.map((staging) => {
                  const image = assetUrl(staging.cover_image || play.cover_image);
                  return (
                    <a class="staging-row" href={`/plays/${play.slug}/stagings/${staging.slug}`}>
                      {image && <img src={image} alt="" loading="lazy" />}
                      <div>
                        <p class="kicker">
                          {staging.date ? dateFormatter.format(new Date(staging.date)) : 'Tarih yakında'}
                        </p>
                        <h2>{staging.title}</h2>
                        <p>{staging.summary || staging.production_notes || 'Sahneleme ayrıntıları yakında.'}</p>
                      </div>
                      <dl>
                        <div>
                          <dt>Mekan</dt>
                          <dd>{staging.venue || 'Belirsiz'}</dd>
                        </div>
                        <div>
                          <dt>Tarih / Saat</dt>
                          <dd>{staging.date ? dateFormatter.format(new Date(staging.date)) : 'Yakında'}</dd>
                        </div>
                      </dl>
                    </a>
                  );
                })}
              </div>
            ) : (
              <p class="empty-state">Bu oyun için yayınlanmış sahneleme kaydı henüz yok.</p>
            )}
          </section>

          <section class="related-section" aria-labelledby="production-notes-heading">
            <div class="split">
              <div>
                <p class="kicker" id="production-notes-heading">Üretim</p>
                <p class="prose">
                  {play.setting ||
                    play.themes ||
                    'Bu alanda oyunun sahneleme yaklaşımı, prova notları ve üretim bağlamı gösterilir.'}
                </p>
                <div class="taxonomy">
                  {[...genres, ...tags].map((item) => <span>{item}</span>)}
                </div>
              </div>
              <div>
                <p class="kicker">Metin</p>
                <p class="prose">
                  Metin bilgileri, hak notları ve kaynak bağlantıları ayrı metin detayında tutulur.
                </p>
                {scriptHref && (
                  <a class="button compact-button detail-source-button" href={scriptHref}>
                    Metin Detayına Git
                  </a>
                )}
              </div>
            </div>
          </section>

          {relatedPosts.length > 0 && (
            <section class="related-section" aria-labelledby="related-blog-heading">
              <p class="kicker" id="related-blog-heading">Blog</p>
              <div class="article-list compact-list">
                {relatedPosts.map((post) => (
                  <a href={`/blog/${post.slug}`}>
                    <p class="kicker">{post.author_name || 'SUOyuncuları'}</p>
                    <h2>{post.title}</h2>
                    <p>{post.excerpt}</p>
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <h1>Oyun bulunamadı</h1>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
