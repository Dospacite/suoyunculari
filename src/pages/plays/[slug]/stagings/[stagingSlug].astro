---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { assetUrl, getPlayBySlug, getStagingBySlug, getStagingsForPlay } from '@/lib/directus';
import { renderMarkdown } from '@/lib/markdown';

export const prerender = false;

const playSlug = Astro.params.slug ?? '';
const stagingSlug = Astro.params.stagingSlug ?? '';
let staging = playSlug && stagingSlug ? await getStagingBySlug(playSlug, stagingSlug) : undefined;
if (!staging && playSlug && stagingSlug) {
  const fallbackPlay = await getPlayBySlug(playSlug);
  const stagings = fallbackPlay ? await getStagingsForPlay(playSlug, fallbackPlay) : [];
  staging = stagings.find((item) => item.slug === stagingSlug);
}
const play = staging?.play;
if (!staging || !play) Astro.response.status = 404;

const coverImage = assetUrl(staging?.cover_image || play?.cover_image);
const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const timeFormatter = new Intl.DateTimeFormat('tr-TR', {
  hour: '2-digit',
  minute: '2-digit',
});
const castText = play?.cast || staging?.cast_notes;
const videoEmbedUrl = getYouTubeEmbedUrl(staging?.video_url);
const stagingNoteHtml = renderMarkdown(staging?.body || staging?.production_notes);
const castHtml = renderMarkdown(castText);
const hasMeta = Boolean(staging?.date || staging?.venue || play?.title);

function getYouTubeEmbedUrl(value?: string): string | undefined {
  if (!value) return undefined;

  try {
    const url = new URL(value);
    const hostname = url.hostname.replace(/^www\./, '');
    let id = '';

    if (hostname === 'youtu.be') {
      id = url.pathname.slice(1);
    } else if (hostname === 'youtube.com' || hostname === 'm.youtube.com') {
      id = url.searchParams.get('v') || url.pathname.match(/\/shorts\/([^/]+)/)?.[1] || url.pathname.match(/\/embed\/([^/]+)/)?.[1] || '';
    }

    return id ? `https://www.youtube.com/embed/${encodeURIComponent(id)}` : undefined;
  } catch {
    return undefined;
  }
}
---

<BaseLayout title={staging?.title ?? 'Sahneleme bulunamadı'} description={staging?.summary || play?.summary}>
  <main class="section compact">
    {
      staging && play ? (
        <article class="section-inner">
          <div class="section-heading">
            <h1>{staging.title}</h1>
            <div class="button-row">
              <a class="button detail-source-button" href={`/plays/${play.slug}`}>
                Oyun Detayı
              </a>
              {staging.ticket_url && (
                <a class="button secondary-button detail-source-button" href={staging.ticket_url} target="_blank" rel="noreferrer">
                  Bilet / Duyuru
                </a>
              )}
            </div>
          </div>

          {coverImage && <img class="staging-cover" src={coverImage} alt="" />}

          {videoEmbedUrl ? (
            <div class="staging-video">
              <iframe
                title={`${staging.title} video`}
                src={videoEmbedUrl}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          ) : staging.video_url ? (
            <a class="button detail-source-button" href={staging.video_url} target="_blank" rel="noreferrer">
              Video
            </a>
          ) : null}

          {hasMeta && (
            <div class="detail-meta">
              {staging.date && (
                <div>
                  <dt>Tarih</dt>
                  <dd>{dateFormatter.format(new Date(staging.date))}</dd>
                </div>
              )}
              {staging.date && (
                <div>
                  <dt>Saat</dt>
                  <dd>{timeFormatter.format(new Date(staging.date))}</dd>
                </div>
              )}
              {staging.venue && (
                <div>
                  <dt>Mekan</dt>
                  <dd>{staging.venue}</dd>
                </div>
              )}
              <div>
                <dt>Oyun</dt>
                <dd>{play.title}</dd>
              </div>
            </div>
          )}

          {(stagingNoteHtml || castHtml) && (
            <div class="split">
              {stagingNoteHtml && (
                <div>
                  <p class="kicker">Sahneleme Notu</p>
                  <div class="prose markdown-content" set:html={stagingNoteHtml} />
                </div>
              )}
              {castHtml && (
                <div>
                  <p class="kicker">Kadro / Ekip</p>
                  <div class="prose markdown-content" set:html={castHtml} />
                </div>
              )}
            </div>
          )}

          {staging.photos && staging.photos.length > 0 && (
            <section class="related-section" aria-labelledby="photos-heading">
              <div class="section-heading small-heading">
                <h2>Sahneleme Arşivi</h2>
              </div>
              <div class="photo-grid">
                {staging.photos.map((photo) => {
                  const image = assetUrl(photo.image);
                  return image ? (
                    <figure>
                      <img src={image} alt={photo.alt_text || photo.caption || ''} loading="lazy" />
                      {photo.caption && <figcaption>{photo.caption}</figcaption>}
                    </figure>
                  ) : null;
                })}
              </div>
            </section>
          )}
        </article>
      ) : (
        <article class="section-inner">
          <div class="section-heading">
            <h1>Sahneleme bulunamadı</h1>
          </div>
        </article>
      )
    }
  </main>
</BaseLayout>
