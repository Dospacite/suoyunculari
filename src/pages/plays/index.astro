---
import PlayList from '@/components/PlayList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPlays } from '@/lib/directus';

const plays = await getPlays();
---

<BaseLayout title="Plays" description="Search the published SU Oyunculari play archive.">
  <main class="section compact">
    <div class="section-inner">
      <div class="section-heading">
        <p class="kicker">Archive</p>
        <h1>Plays</h1>
        <p>Search published play records by title, author, genre, difficulty, cast size, and rights status.</p>
      </div>
      <PlayList plays={plays} />
    </div>
  </main>
</BaseLayout>
