---
import YkLayout from '@/layouts/YkLayout.astro';
import { getGoogleDriveStatus } from '@/lib/google-drive';
import { getRollCallData, listSheets } from '@/lib/yk';
import { isAdmin } from '@/lib/yk';

const user = Astro.locals.user!;
const sheets = await listSheets();
const selectedId = Astro.url.searchParams.get('sheet') || sheets[0]?.id || '';
const data = selectedId ? await getRollCallData(selectedId) : null;
const driveStatus = isAdmin(user) ? await getGoogleDriveStatus(Astro.url) : null;
const driveMessage = Astro.url.searchParams.get('drive');
const driveError = Astro.url.searchParams.get('message');
---

<YkLayout title="Ayarlar" user={user}>
  <header class="page-head">
    <h1>Ayarlar</h1>
  </header>

  {
    driveStatus && (
      <section class="panel drive-settings">
        <div>
          <h2>Pingo Google Drive</h2>
          <p>Connect the Drive account Pingo uses to search and send script files.</p>
        </div>
        {driveMessage === 'connected' && <p class="notice ok">Google Drive bağlantısı hazır.</p>}
        {driveMessage === 'error' && <p class="notice error">{driveError || 'Google Drive bağlantısı tamamlanamadı.'}</p>}
        <dl class="detail-list">
          <div>
            <dt>OAuth config</dt>
            <dd>{driveStatus.configured ? 'Configured' : 'Missing client id or secret'}</dd>
          </div>
          <div>
            <dt>Account</dt>
            <dd>{driveStatus.connected ? driveStatus.accountEmail || 'Connected' : 'Not connected'}</dd>
          </div>
          <div>
            <dt>Redirect URI</dt>
            <dd>{driveStatus.redirectUri}</dd>
          </div>
          <div>
            <dt>Download base</dt>
            <dd>{driveStatus.publicBaseUrl}</dd>
          </div>
        </dl>
        <div class="toolbar compact-toolbar">
          <a class="button" href="/api/pingo/drive/oauth/start" aria-disabled={!driveStatus.configured}>
            {driveStatus.connected ? 'Reconnect Drive' : 'Connect Drive'}
          </a>
          {
            driveStatus.connected && (
              <form data-drive-disconnect>
                <button type="submit" class="secondary">Disconnect</button>
              </form>
            )
          }
        </div>
      </section>
    )
  }

  {
    data ? (
      <section class="panel">
        <div class="toolbar">
          <label>
            Çizelge
            <select id="sheet-select">
              {sheets.map((sheet) => <option value={sheet.id} selected={sheet.id === selectedId}>{sheet.name}</option>)}
            </select>
          </label>
        </div>
        <h2>Yoklama durumları</h2>
        <div class="state-list">
          {data.states.map((state) => (
            <form class="state-row" data-state-form data-id={state.id}>
              <label>
                Etiket
                <input name="label" value={state.label} required />
              </label>
              <label>
                Puan
                <input name="points" type="number" min="0" max="100" value={state.points} required />
              </label>
              <label>
                Renk
                <input name="color" type="color" value={state.color || '#101013'} />
              </label>
              <button class="icon-button save" type="submit" aria-label="Kaydet" title="Kaydet">Kaydet</button>
            </form>
          ))}
        </div>
      </section>
    ) : (
      <section class="panel"><p>Önce bir yoklama çizelgesi oluştur.</p></section>
    )
  }

  <script>
    // @ts-nocheck
    const postJson = async (url, method, body) => {
      const response = await fetch(url, {
        method,
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) throw new Error('İşlem başarısız');
    };

    document.querySelector('#sheet-select')?.addEventListener('change', (event) => {
      window.location.href = `/settings?sheet=${encodeURIComponent(event.currentTarget.value)}`;
    });

    document.querySelector('[data-drive-disconnect]')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      await postJson('/api/pingo/drive/disconnect', 'POST', {});
      window.location.href = '/settings';
    });

    document.querySelectorAll('[data-state-form]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = Object.fromEntries(new FormData(form).entries());
        body.points = Number(body.points);
        await postJson(`/api/roll-call/states/${form.dataset.id}`, 'PATCH', body);
        window.location.reload();
      });
    });
  </script>
</YkLayout>

<style>
  .drive-settings {
    margin-bottom: 18px;
  }

  .compact-toolbar {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .notice {
    border-left: 4px solid var(--line);
    padding: 12px;
  }

  .notice.ok {
    background: #edf8f1;
    border-color: var(--ok);
    color: var(--ok);
  }

  .drive-settings dd {
    overflow-wrap: anywhere;
  }
</style>
